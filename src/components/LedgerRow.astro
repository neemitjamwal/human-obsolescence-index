---
import CategoryChip from './CategoryChip.astro';
import ScoreBar from './ScoreBar.astro';
import { changeGlyph, changeTone, formatSignedPercent } from '../lib/format';
import { scoreBand, type BlsCategory } from '../lib/ledger';

interface Props {
  /** Leaderboard rank; null for tracked occupations that are not on the ranked board. */
  rank: number | null;
  occupation: string;
  obs: number;
  /** BLS projected employment change, percent, 2025–35. */
  change: number | null;
  category?: BlsCategory | null;
  href: string;
  exposure?: number | null;
  trajectory?: number | null;
}

const { rank, occupation, obs, change, category = null, href, exposure = null, trajectory = null } = Astro.props;
const tone = changeTone(change);
const changeText = formatSignedPercent(change);
const changeLabel =
  change == null
    ? 'BLS publishes no projected change'
    : tone === 'flat'
      ? 'BLS projects no change in employment, 2025 to 2035'
      : `BLS projects employment ${tone === 'decline' ? 'down' : 'up'} ${changeText.slice(1)}, 2025 to 2035`;
const breakdown = `OBS ${obs} = 0.65 × Exposure ${exposure ?? 'n/a'} + 0.35 × Trajectory ${trajectory ?? 'n/a'}`;
---

<li>
  <a href={href} class="ledger-row" data-ledger-row data-rank={rank ?? undefined} data-obs={obs} data-band={scoreBand(obs)} data-category={category ?? 'none'} data-slug={href.split('/').filter(Boolean).pop()}>
    <span class="ledger-rank">
      {rank == null ? <><span aria-hidden="true">···</span><span class="sr-only">Unranked</span></> : <><span class="sr-only">Rank </span>{String(rank).padStart(3, '0')}</>}
    </span>
    <span class="ledger-name">{occupation}</span>
    <span class="ledger-bar" title={breakdown}><ScoreBar score={obs} /></span>
    <span class:list={['ledger-delta', `change-${tone}`]}>
      <span aria-hidden="true">{changeGlyph(tone)} {changeText}</span>
      <span class="sr-only">, {changeLabel}</span>
    </span>
    <span class="ledger-chip"><CategoryChip category={category} /></span>
  </a>
</li>
