---
import { CARD_SIZES } from '../lib/card';
---

<section class="share-panel box" aria-labelledby="share-h" data-share-panel>
  <h2 id="share-h" class="sub-h">Post your front page</h2>
  <p class="fine mt-1">Cards are drawn in your browser. Nothing is uploaded, and your name stays on your device.</p>
  <div class="share-previews mt-3">
    <figure class="share-story">
      <canvas
        class="share-canvas"
        width={CARD_SIZES.story.width}
        height={CARD_SIZES.story.height}
        data-card="story"
        role="img"
        aria-label="Story card preview"></canvas>
      <figcaption class="kicker mt-2">Story card · {CARD_SIZES.story.width} × {CARD_SIZES.story.height}</figcaption>
    </figure>
    <figure class="share-post">
      <canvas
        class="share-canvas"
        width={CARD_SIZES.post.width}
        height={CARD_SIZES.post.height}
        data-card="post"
        role="img"
        aria-label="Post card preview"></canvas>
      <figcaption class="kicker mt-2">Post card · {CARD_SIZES.post.width} × {CARD_SIZES.post.height}</figcaption>
    </figure>
  </div>
  <div class="share-actions mt-4">
    <button type="button" class="btn btn-red" data-share-download="story">Download story PNG</button>
    <button type="button" class="btn" data-share-download="post">Download post PNG</button>
    <button type="button" class="btn btn-yellow" data-share-native>Share</button>
    <button type="button" class="btn" data-share-copy>Copy link</button>
  </div>
  <p class="mt-3">
    <label class="kicker block" for="share-url">Your link</label>
    <input id="share-url" class="share-url" type="text" readonly data-share-url value="" />
  </p>
  <p class="share-status mt-2 font-bold" role="status" aria-live="polite" data-share-status></p>
</section>
