---
import { MUSEUM_PRECEDENTS, museumExhibitUrl, museumObituaryUrl, precedentHeadline } from '../data/precedents';

interface Props {
  soc: string;
  slug: string;
}

const precedent = MUSEUM_PRECEDENTS[Astro.props.soc];
---

<div data-museum-precedent-slot={Astro.props.soc}>
  {
    precedent && (
      <aside class="box-ink mt-12 p-5" aria-labelledby="precedent-title" data-museum-precedent={precedent.exhibit.slug}>
        <p class="eyebrow">From the archives</p>
        <h2 id="precedent-title" class="sub-h mt-3 text-yellow">{precedentHeadline(precedent)}</h2>
        <p class="prose-block mt-3">{precedent.why}</p>
        <p class="prose-block mt-2 text-[#e8e4d4]">{precedent.exhibit.context}</p>
        <p class="mt-4">
          <a class="btn btn-yellow" href={museumExhibitUrl(precedent.exhibit)}>
            Visit the {precedent.exhibit.name.toLowerCase()} exhibit at the Museum of Extinct Jobs →
          </a>
        </p>
      </aside>
    )
  }
  <p class="mt-6" data-museum-obituary>
    <a class="btn btn-red" href={museumObituaryUrl(Astro.props.slug)}>Read its obituary →<span class="sr-only"> at the Museum of Extinct Jobs</span></a>
  </p>
</div>
