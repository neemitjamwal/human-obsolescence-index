---
import { NAV_ITEMS, SITE_NAME, isActive } from '../lib/site';

const pathname = Astro.url.pathname;
---

<header class="border-b border-grid bg-slate/95">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 md:flex-row md:items-center md:justify-between md:px-6">
    <a href="/" class="group flex items-center gap-3 no-underline" aria-label={`${SITE_NAME}, home`}>
      <svg class="h-8 w-8 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" fill="#161b22" stroke="#21262d" />
        <path d="M5 22a11 11 0 0 1 22 0" fill="none" stroke="#21262d" stroke-width="3" />
        <path d="M5 22a11 11 0 0 1 5.5-9.5" fill="none" stroke="#2ea043" stroke-width="3" />
        <path d="M21.5 12.5A11 11 0 0 1 27 22" fill="none" stroke="#f85149" stroke-width="3" />
        <path d="M16 22l7-8" stroke="#e6edf3" stroke-width="1.8" stroke-linecap="square" />
        <circle cx="16" cy="22" r="1.8" fill="#e6edf3" />
      </svg>
      <span class="flex flex-col leading-tight">
        <span class="font-display text-base font-extrabold uppercase tracking-wide text-paper group-hover:text-phosphor md:text-lg">
          {SITE_NAME}
        </span>
        <span class="term-label text-[0.625rem] text-dim">HOI · Live since 1767<span class="text-alert"> ▲</span></span>
      </span>
    </a>
    <nav aria-label="Main">
      <ul class="term-label flex flex-wrap gap-x-5 gap-y-1">
        {
          NAV_ITEMS.map((item) => {
            const active = isActive(item, pathname);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'inline-block py-1.5 no-underline transition-colors hover:text-phosphor',
                    active ? 'border-b-2 border-phosphor text-phosphor' : 'text-paper',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
