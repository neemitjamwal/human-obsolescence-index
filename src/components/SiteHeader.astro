---
import { MASTHEAD, NAV_ITEMS, SITE_NAME, isActive } from '../lib/site';
import { META } from '../lib/data';

interface Props {
  /** The full-size masthead belongs to the front page; inner pages get the compact one. */
  size?: 'full' | 'compact';
}

const { size = 'compact' } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class:list={['masthead', size === 'compact' && 'masthead-compact']}>
  <div class="masthead-ears mx-auto max-w-6xl">
    <span>{META.edition} edition</span>
    <span>Price: your job</span>
  </div>
  <a href="/" class="masthead-name" aria-label={`${MASTHEAD}: ${SITE_NAME}, front page`}>{MASTHEAD.toUpperCase()}</a>
  <p class="masthead-sub">
    The {SITE_NAME} · {META.leaderboard.size} jobs ranked by Doom Score · AI exposure &amp; BLS projections
  </p>
</header>
<nav aria-label="Main" class="site-nav">
  <ul>
    {
      NAV_ITEMS.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item, pathname) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))
    }
  </ul>
</nav>
