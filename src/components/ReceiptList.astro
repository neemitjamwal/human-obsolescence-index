---
import { sourceById } from '../lib/data';

interface Props {
  ids: string[];
}

const sources = Astro.props.ids.map(sourceById);
---

<ol class="receipt-list">
  {
    sources.map((s) => (
      <li id={`src-${s.id}`} data-source-id={s.id} class="receipt">
        <p class="kicker text-red">[{s.id}]</p>
        <p class="mt-1 font-display text-xl uppercase leading-tight">{s.name}</p>
        <p class="font-bold">{s.publisher}</p>
        <p class="mt-2">{s.citation}</p>
        <dl class="receipt-meta kicker mt-2">
          <div><dt>Source</dt><dd><a href={s.url} class="underline">{s.file ?? s.url}</a></dd></div>
          {s.methodologyUrl && <div><dt>Docs</dt><dd><a href={s.methodologyUrl} class="underline">{s.methodologyUrl.replace(/^https?:\/\//, '')}</a></dd></div>}
          <div><dt>Retrieved</dt><dd>{s.retrievedAt.slice(0, 10)}</dd></div>
          <div><dt>License</dt><dd>{s.licenseUrl ? <a href={s.licenseUrl} class="underline">{s.license}</a> : s.license}</dd></div>
          <div><dt>SHA-256</dt><dd class="break-all">{s.sha256 ?? 'derived, not a download'}</dd></div>
        </dl>
      </li>
    ))
  }
</ol>
