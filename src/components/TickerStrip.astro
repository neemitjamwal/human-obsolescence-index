---
import type { TickerEntry } from '../lib/press';

interface Props {
  items: TickerEntry[];
  label?: string;
}

const { items, label = 'Breaking news ticker' } = Astro.props;
---

<section class="ticker" aria-label={label} tabindex="0" data-ticker>
  <div class="ticker-track">
    {
      [false, true].map((duplicate) => (
        <ul class="ticker-list" aria-hidden={duplicate ? 'true' : undefined}>
          <li>Breaking</li>
          {items.map((item) => (
            <li>
              <span aria-hidden="true">{item.glyph} </span>
              {item.label}
              {item.value && <> {item.value}</>}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>
