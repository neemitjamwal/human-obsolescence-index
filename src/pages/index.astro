---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryChip from '../components/CategoryChip.astro';
import CiteLink from '../components/CiteLink.astro';
import { leaderboard, META, occupationPath } from '../lib/data';
import { formatJobs, formatSignedPercent } from '../lib/format';
import { BAND_LABELS, scoreBand } from '../lib/ledger';

const board = leaderboard();
const top = board[0];
const topObs = top.scores.obs.value!;
const topBand = BAND_LABELS[scoreBand(topObs)];
const shame = board.slice(0, 10);
const u = META.universe;
---

<BaseLayout
  masthead="full"
  description={`The ${META.edition} Human Obsolescence Index: ${board.length} occupations ranked by a Doom Score built from AI exposure and BLS projected employment change, every number with its source.`}
>
  <!--
    HERO SLOT. The "Type your job" combobox, name field, verdict reveal and share cards replace the contents of
    this section (feature index-verdict-hero-and-share). Keep the data-hero-slot attribute on the replacement.
  -->
  <section class="mx-auto grid max-w-6xl gap-6 px-4 pb-10 pt-8 md:px-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-start" aria-labelledby="hero-title" data-hero-slot>
    <div>
      <h1 id="hero-title" class="hook-h">Type your job.<br /><span class="hl">We print the headline.</span></h1>
      <p class="prose-block mt-5 font-bold">
        {u.obsScored} occupations scored. {board.length} on the board. Every number traced to a public source. The
        search box goes to press next edition; until then, find your job on the full board.
      </p>
      <p class="mt-6 flex flex-wrap gap-3">
        <a class="btn btn-red" href="/leaderboard/">See all {board.length} on the Doom Index →</a>
        <a class="btn" href="/methodology/">How we score it</a>
      </p>
    </div>

    <article class="box-yellow anim-slam p-4 md:p-5" aria-labelledby="splash-title" data-front-splash>
      <p class="kicker text-red">Exclusive · Job No. {top.soc}</p>
      <h2 id="splash-title" class="mt-2 font-display text-[clamp(2.3rem,9vw,4.25rem)] uppercase leading-[0.92]">
        <a href={occupationPath(top.slug)} class="no-underline hover:text-ink">{top.title}: #1 on the Doom Index</a>
      </h2>
      <div class="splash mt-4">
        <div class="burst anim-spin" role="img" aria-label={`Doom Score ${topObs} out of 100`}>
          <span class="burst-n" aria-hidden="true">{topObs}</span>
          <span class="burst-of" aria-hidden="true">Doom Score<br />out of 100</span>
        </div>
        <div class="grid gap-2">
          <p class="stamp anim-thud">{topBand}</p>
          <p class="fact"><b>#1</b> of {board.length}, most doomed on the board</p>
          <p class="fact">
            BLS projects <b>{formatSignedPercent(top.projectedChange.percent.value)}</b> by 2035:
            {' '}<b>{formatJobs(top.employment.value)} → {formatJobs(top.projectedChange.employment2035.value)}</b> jobs
          </p>
          <p class="fact">BLS official AI exposure category: <CategoryChip category={top.blsCategory.value} /></p>
        </div>
      </div>
      <p class="fine mt-4">
        AI exposure ≠ job loss. Doom Score = 65% AI exposure (Microsoft + OpenAI research) + 35% BLS 2025–35 projection.
        Sources: <CiteLink id="hoi-composite" /> · <CiteLink id="bls-ep" /> · <CiteLink id="bls-ai-exposure" /> ·
        humanobsolescenceindex.com
      </p>
    </article>
  </section>

  <section class="mx-auto max-w-6xl border-t-[6px] border-double border-ink px-4 pt-8 md:px-6" aria-labelledby="shame-title">
    <h2 id="shame-title" class="page-h">Hall of <span class="hl-red">shame</span></h2>
    <p class="prose-block mt-3 font-bold">The {shame.length} most doomed jobs on the board, by Doom Score. Each one has its own page of receipts.</p>
    <ol class="ledger ledger-list ledger-compact mt-5" aria-label={`Top ${shame.length} occupations by Doom Score`} data-home-shame>
      {
        shame.map((o) => (
          <li>
            <a class="ledger-row" href={occupationPath(o.slug)} data-shame-rank={o.leaderboardRank} data-rank={o.leaderboardRank}>
              <span class="ledger-rank"><span class="sr-only">Number </span>{o.leaderboardRank}</span>
              <span class="ledger-name">{o.title}</span>
              <span class="ledger-bar">
                <span class:list={['score-bar', `band-${scoreBand(o.scores.obs.value!)}`]}>
                  <span class="score-bar-track" aria-hidden="true"><span class="score-bar-fill" style={`width: ${o.scores.obs.value}%`}></span></span>
                </span>
              </span>
              <span class="ledger-score"><span class="sr-only">Doom Score </span>{o.scores.obs.value}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <p class="mt-6"><a class="btn btn-yellow" href="/leaderboard/">The full board: all {board.length} →</a></p>
    <p class="fine mt-4">AI exposure ≠ job loss. Exposure measures what AI can do to an occupation's tasks, not whether the job disappears · humanobsolescenceindex.com</p>
  </section>
</BaseLayout>
