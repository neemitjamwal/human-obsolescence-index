---
import BaseLayout from '../layouts/BaseLayout.astro';
import SharePanel from '../components/SharePanel.astro';
import Robot from '../components/Robot.astro';
import VerdictPanel from '../components/VerdictPanel.astro';
import { ART, artSrc, artSrcset } from '../data/art';
import { leaderboard, META } from '../lib/data';
import { scoreBand } from '../lib/ledger';
import { NAME_MAX } from '../lib/name';
import { FEATURED } from '../lib/battle-data';
import { VERDICTS, VERDICTS_META, verdictPath } from '../lib/verdicts';
import { verdictRecord } from '../lib/verdict-feed';
import { verdictView } from '../lib/verdict-view';

const board = leaderboard();
const shame = board.slice(0, 20);
const teaser = FEATURED;
const u = META.universe;
const hero = ART.hero;
// Server-rendered placeholder so the panel's layout exists before the first lookup; the zone stays hidden until then.
const sampleRecord = verdictRecord(VERDICTS[0]);
const sampleView = verdictView(sampleRecord, { edition: VERDICTS_META.edition, boardSize: META.leaderboard.size });
---

<BaseLayout
  masthead="full"
  description={`Robot uprising edition: type your job and get its Doom Score. ${u.obsScored} occupations scored from AI exposure research and BLS projected employment change, every number with its source.`}
>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={artSrcset(hero, 'avif')} imagesizes="100vw" fetchpriority="high" />

  <section class="hero-uprising" aria-labelledby="hero-title" data-hero-slot data-hero>
    <picture class="hero-art">
      <source type="image/avif" srcset={artSrcset(hero, 'avif')} sizes="100vw" />
      <source type="image/webp" srcset={artSrcset(hero, 'webp')} sizes="100vw" />
      <img src={artSrc(hero, 1024, 'webp')} width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" decoding="async" data-hero-art />
    </picture>
    <div class="hero-inner mx-auto max-w-6xl px-4 md:px-6">
      <p class="eyebrow eyebrow-red siren-tag">Breaking · Robot uprising</p>
      <h1 id="hero-title" class="hero-h mt-3">
        <span class="hero-h-line">Robot uprising:</span>
        <span class="hero-h-line"><span class="hl">your job is next</span></span>
      </h1>
      <p class="hero-dek mt-3"><span>The machines are coming for your task list. Type your job. We print the headline.</span></p>

      <form class="job-search box mt-5" role="search" aria-label="Find your job's Doom Score" data-job-form novalidate>
        <label class="job-label" for="job-input">Type your job</label>
        <div class="job-row">
          <div class="job-combo">
            <input
              id="job-input"
              class="job-input"
              type="text"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="job-list"
              aria-describedby="job-hint"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="e.g. accountant, coder, barista"
              data-job-input
            />
            <ul id="job-list" class="job-list" role="listbox" aria-label="Matching jobs" hidden data-job-list></ul>
          </div>
          <button type="submit" class="btn btn-red job-go">Print my verdict</button>
        </div>
        <p id="job-hint" class="fine mt-2">{u.obsScored} occupations, matched on official titles plus O*NET alternate and reported titles. Arrow keys choose, Enter picks.</p>
        <p class="sr-only" role="status" aria-live="polite" data-job-status></p>
        <div class="name-row mt-3">
          <label class="kicker" for="name-input">Put your first name in the paper <span class="name-opt">(optional, stays in your browser and your share link)</span></label>
          <input id="name-input" class="name-input" type="text" maxlength={NAME_MAX * 3} autocomplete="given-name" aria-describedby="name-hint" data-name-input />
          <p id="name-hint" class="fine mt-1">Letters, spaces, hyphens, apostrophes and periods, up to {NAME_MAX} characters. <span data-name-echo aria-live="polite"></span></p>
        </div>
      </form>
    </div>
  </section>

  <section class="verdict-zone mx-auto max-w-6xl px-4 pt-8 md:px-6" aria-label="Your verdict" hidden data-verdict-zone>
    <div class="no-match box p-4 md:p-5" hidden data-no-match tabindex="-1">
      <p class="eyebrow">Stop the presses</p>
      <h2 class="section-h mt-3">No job called “<span data-no-match-q></span>” in our files</h2>
      <p class="prose-block mt-3 font-bold" data-no-match-intro></p>
      <ul class="no-match-list mt-3" data-no-match-list></ul>
      <p class="mt-4"><a class="btn btn-yellow" href="/leaderboard/">Browse the full Doom Index →</a></p>
    </div>
    <VerdictPanel view={sampleView} record={sampleRecord} boardSize={META.leaderboard.size} idPrefix="home" />
    <div class="mt-8"><SharePanel /></div>
  </section>

  <section class="shame mx-auto mt-10 max-w-6xl border-t-[6px] border-double border-ink px-4 pt-8 md:px-6" aria-labelledby="shame-title" data-hall-of-shame>
    <div class="shame-head">
      <div>
        <p class="eyebrow eyebrow-red siren-tag">Wanted by the robots</p>
        <h2 id="shame-title" class="shame-h mt-3">Hall of <span>shame</span></h2>
        <p class="prose-block mt-3 font-bold">The {shame.length} most doomed jobs on the board, by Doom Score. Each one has its own verdict page and share card.</p>
      </div>
      <ul class="shame-robots" aria-label="The robots doing the hunting">
        <li><Robot pose="pointing" id="shame-pointing" /></li>
        <li><Robot pose="pinkslip" id="shame-pinkslip" /></li>
        <li><Robot pose="peeking" id="shame-peeking" /></li>
      </ul>
    </div>
    <ol class="ledger ledger-list ledger-compact shame-board mt-5" aria-label={`Top ${shame.length} occupations by Doom Score`} data-home-shame>
      {
        shame.map((o) => (
          <li>
            <a class="ledger-row" href={verdictPath(o.slug)} data-shame-rank={o.leaderboardRank} data-rank={o.leaderboardRank} data-obs={o.scores.obs.value}>
              <span class="ledger-rank"><span class="sr-only">Number </span>{o.leaderboardRank}</span>
              <span class="ledger-name">{o.title}</span>
              <span class="ledger-bar">
                <span class:list={['score-bar', `band-${scoreBand(o.scores.obs.value!)}`]}>
                  <span class="score-bar-track" aria-hidden="true"><span class="score-bar-fill" style={`width: ${o.scores.obs.value}%`}></span></span>
                </span>
              </span>
              <span class="ledger-score"><span class="sr-only">Doom Score </span>{o.scores.obs.value}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="shame-foot mt-6">
      <a class="btn btn-yellow" href="/leaderboard/">The full board: all {board.length} →</a>
      <Robot pose="shovel" id="shame-shovel" decorative class="shame-shovel" />
    </div>
    <p class="fine mt-4">AI exposure ≠ job loss. Exposure measures what AI can do to an occupation's tasks, not whether the job disappears. <a href="/methodology/">How we score it</a></p>
  </section>

  <section class="mx-auto mt-10 max-w-6xl px-4 pb-4 md:px-6" aria-labelledby="teaser-title" data-battle-teaser>
    <article class="battle-teaser box-ink">
      <p class="battle-k">Who's safer? · Fight night</p>
      <h2 id="teaser-title" class="sr-only">Who's safer? {teaser.view.a.title} versus {teaser.view.b.title}</h2>
      <div class="teaser-ring mt-4">
        <a class="fighter fighter-red" href={verdictPath(teaser.a.slug)} data-fighter="a" data-fate={teaser.view.a.fate}>
          <span class="fighter-n" data-obs-score={teaser.a.obs}>{teaser.a.obs}</span>
          <span class="fighter-t">{teaser.a.title}</span>
        </a>
        <p class="vs" aria-hidden="true">VS</p>
        <a class="fighter fighter-blue" href={verdictPath(teaser.b.slug)} data-fighter="b" data-fate={teaser.view.b.fate}>
          <span class="fighter-n" data-obs-score={teaser.b.obs}>{teaser.b.obs}</span>
          <span class="fighter-t">{teaser.b.title}</span>
        </a>
      </div>
      <p class="battle-verdict mt-3">{teaser.view.headline}.</p>
      <p class="roast battle-quip mt-2">{teaser.view.quip}</p>
      <p class="battle-sub mt-2">{teaser.view.projectionLine}</p>
      <p class="teaser-actions mt-4">
        <a class="btn btn-yellow" href="/vs/">Pick two jobs. Start a fight.</a>
        <a class="btn" href={teaser.path}>See this fight →</a>
      </p>
      <p class="fine mt-3">{teaser.view.fine} <a href="/methodology/" class="font-bold">How the Doom Score works</a></p>
    </article>
  </section>
</BaseLayout>

<script>
  import { initHero } from '../lib/hero';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) initHero(root);
</script>
