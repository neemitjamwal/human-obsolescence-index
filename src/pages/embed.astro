---
import { META } from '../lib/data';
import { formatSignedPercent } from '../lib/format';
import { SITE_NAME } from '../lib/site';
import { DEFAULT_OG_IMAGE, OG_IMAGE_SIZE } from '../lib/seo';
import { EMBED_PATH, embedEntries, embedJson, embedSnippet } from '../lib/embed';

const site = Astro.site!;
const entries = embedEntries(site);
const ticker = entries.slice(0, 12);
const initial = entries.slice(0, 5);
const snippet = embedSnippet(site);
const home = new URL('/', site).href;
const methodology = new URL('/methodology/', site).href;
const canonical = new URL(EMBED_PATH, site).href;
const imageUrl = new URL(DEFAULT_OG_IMAGE, site).href;
const title = `Embeddable ticker · ${SITE_NAME}`;
const description = `A free, self-contained widget: the live ${META.edition} OBS ticker and a score lookup for the ${entries.length} occupations on the Human Obsolescence Index board. Copy one iframe; attribution included.`;
const tone = (band: string) => (band === 'Severe' || band === 'Elevated' ? 'red' : band === 'Moderate' ? 'ink' : 'blue');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#e4002b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      /* Self-hosted latin subsets (SIL OFL, see /fonts/*-OFL.txt) so the widget makes no third-party requests. */
      @font-face { font-family: 'Anton'; font-style: normal; font-weight: 400; font-display: swap; src: url(/fonts/anton-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: 'Archivo'; font-style: normal; font-weight: 400 900; font-display: swap; src: url(/fonts/archivo-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      :root { color-scheme: light; --ink: #0b0b0b; --paper: #fffbea; --yellow: #ffe500; --red: #e4002b; --blue: #1f5bff; --muted: #3d3a33; --head: 'Anton', Impact, 'Arial Narrow Bold', sans-serif; --body: 'Archivo', Arial, 'Helvetica Neue', sans-serif; }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--paper); color: var(--ink); font: 14px/1.45 var(--body); }
      body { background-image: radial-gradient(rgba(11, 11, 11, .09) 1px, transparent 1.3px); background-size: 6px 6px; }
      a { color: var(--ink); text-decoration-color: var(--red); text-decoration-thickness: 2px; }
      a:hover { color: var(--red); }
      a:focus-visible, button:focus-visible, input:focus-visible { outline: 4px solid var(--blue); outline-offset: 2px; }
      .hoi { max-width: 680px; margin: 0 auto; border: 4px solid var(--ink); background: #fff; box-shadow: 6px 6px 0 var(--ink); }
      .hoi-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 12px; padding: 8px 12px; border-bottom: 4px double var(--ink); text-transform: uppercase; letter-spacing: .08em; font-size: 11px; font-weight: 900; }
      .hoi-head strong { font: 400 26px/1 var(--head); letter-spacing: 0; color: var(--red); -webkit-text-stroke: 1px var(--ink); text-shadow: 2px 2px 0 var(--ink); }
      .hoi-ticker { overflow: hidden; border-bottom: 3px solid var(--ink); background: var(--red); }
      .hoi-track { display: flex; width: max-content; animation: hoi-scroll 45s linear infinite; }
      .hoi-ticker:hover .hoi-track, .hoi-ticker:focus-within .hoi-track { animation-play-state: paused; }
      .hoi-track ul { display: flex; gap: 22px; margin: 0; padding: 4px 12px; list-style: none; white-space: nowrap; font: 400 18px/1.5 var(--head); letter-spacing: .03em; text-transform: uppercase; }
      .hoi-track a { color: #fff; text-decoration: none; }
      .hoi-track a:hover { color: var(--yellow); }
      @keyframes hoi-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      @media (prefers-reduced-motion: reduce) {
        .hoi-ticker { overflow-x: auto; }
        .hoi-track { animation: none; }
        .hoi-track ul[aria-hidden] { display: none; }
      }
      .red { color: var(--red); } .ink { color: var(--ink); } .blue { color: var(--blue); } .dim { color: var(--muted); }
      .hoi-body { padding: 12px; }
      .hoi-body label { display: block; font-size: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: .12em; }
      .hoi-body input { width: 100%; margin-top: 6px; padding: 8px 10px; border: 3px solid var(--ink); background: var(--yellow); color: var(--ink); font: 400 22px/1.1 var(--head); text-transform: uppercase; caret-color: var(--red); }
      .hoi-body input::placeholder { color: var(--muted); }
      .hoi-status { margin: 8px 0 0; font-size: 12px; font-weight: 700; }
      .hoi-results { margin: 8px 0 0; padding: 0; list-style: none; border: 3px solid var(--ink); }
      .hoi-results:empty { display: none; }
      .hoi-results li { display: grid; grid-template-columns: 2.6em minmax(0, 1fr) auto; gap: 2px 10px; align-items: center; padding: 8px 10px; }
      .hoi-results li + li { border-top: 2px dashed var(--ink); }
      .hoi-results li:first-child { background: var(--yellow); }
      /* Red at this size is only 3.8:1 on yellow. */
      .hoi-results li:first-child .hoi-rank { color: var(--ink); }
      .hoi-results a { font-weight: 900; text-transform: uppercase; overflow-wrap: anywhere; }
      .hoi-rank { font: 400 22px/1 var(--head); color: var(--red); }
      .hoi-score { font: 400 30px/1 var(--head); text-align: right; }
      .hoi-meta { grid-column: 2 / 4; font-size: 11px; }
      .hoi-foot { padding: 10px 12px; border-top: 3px solid var(--ink); background: var(--yellow); font-size: 11px; }
      .hoi-foot p { margin: 0 0 4px; }
      .hoi-docs { max-width: 680px; margin: 24px auto 40px; padding: 0 2px; }
      .hoi-docs h1 { font: 400 40px/1 var(--head); text-transform: uppercase; margin: 0 0 10px; }
      .hoi-docs h1 span { background: var(--yellow); padding: 0 .1em; }
      .hoi-docs pre { overflow-x: auto; padding: 10px; border: 3px solid var(--ink); background: #fff; white-space: pre-wrap; word-break: break-all; font-size: 12px; }
      .hoi-docs button { padding: 10px 14px; border: 3px solid var(--ink); background: var(--red); color: #fff; font: 400 18px/1 var(--head); text-transform: uppercase; letter-spacing: .04em; box-shadow: 4px 4px 0 var(--ink); cursor: pointer; }
      .hoi-docs button:hover { transform: translate(-1px, -1px); }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      .framed .hoi-docs { display: none; }
      .framed body { padding: 0; }
      .framed .hoi { box-shadow: none; }
      body { padding: 12px; }
    </style>
  </head>
  <body>
    <main>
      <section class="hoi" aria-label={`${SITE_NAME} widget`} data-embed-widget>
        <div class="hoi-head">
          <span><strong>THE DAILY DOOM</strong> · HOI ticker</span>
          <span class="dim">{META.edition} · data as of {META.dataAsOf}</span>
        </div>
        <section class="hoi-ticker" aria-label={`Top ${ticker.length} Doom Scores (OBS)`} data-embed-ticker>
          <div class="hoi-track">
            {
              [false, true].map((duplicate) => (
                <ul aria-hidden={duplicate ? 'true' : undefined}>
                  {ticker.map((e) => (
                    <li>
                      <a href={e.u} target="_blank" rel="noopener" tabindex={duplicate ? '-1' : undefined}>
                        <span aria-hidden="true">★ </span>{e.t} OBS {e.o}
                      </a>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </section>
        <div class="hoi-body" data-embed-lookup>
          <label for="hoi-q">Look up an occupation</label>
          <input id="hoi-q" type="search" autocomplete="off" spellcheck="false" placeholder="e.g. translator, cashier, programmer" aria-describedby="hoi-status" />
          <p id="hoi-status" class="hoi-status" aria-live="polite">Top {initial.length} of {entries.length} on the board. Type to search.</p>
          <ul id="hoi-results" class="hoi-results">
            {
              initial.map((e) => (
                <li>
                  <span class="hoi-rank">#{e.r}</span>
                  <a href={e.u} target="_blank" rel="noopener">{e.t}</a>
                  <span class:list={['hoi-score', tone(e.b)]}>{e.o}</span>
                  <span class="hoi-meta">Doom Score band {e.b} · BLS category {e.c ?? 'not rated'} · BLS 2025–35 {formatSignedPercent(e.p)}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="hoi-foot">
          <p>
            Doom Score (OBS) = our composite of Microsoft, OpenAI and BLS data, 0–100. BLS category = the government's own label.
            AI exposure ≠ job loss: exposure measures what AI can do to a job's tasks, not whether the job disappears.{' '}
            <a href={methodology} target="_blank" rel="noopener">Methodology</a>
          </p>
          <p>
            Data: <a href={home} target="_blank" rel="noopener" data-embed-attribution>{SITE_NAME}</a> · gallows humor with receipts
          </p>
        </div>
      </section>

      <section class="hoi-docs" aria-labelledby="embed-title" data-embed-docs>
        <h1 id="embed-title"><span>Put the ticker on your site</span></h1>
        <p>
          Copy this snippet into any page. The widget is one static file: no cookies, no trackers, no third-party
          requests. It shows the {entries.length} occupations on the {META.edition} board and updates when the Index does,
          each quarter. Keep the attribution line.
        </p>
        <pre><code id="hoi-snippet" data-embed-snippet>{snippet}</code></pre>
        <p><button type="button" id="hoi-copy">Copy snippet</button> <span id="hoi-copied" class="dim" aria-live="polite"></span></p>
        <p>
          Back to the <a href="/">{SITE_NAME} front page</a> · <a href="/leaderboard/">Leaderboard</a> · <a href="/methodology/">Methodology</a> ·{' '}
          <a href="/press/">Press kit</a> · <a href="/about/">About</a>
        </p>
      </section>
    </main>

    <script type="application/json" id="hoi-data" set:html={embedJson(entries)}></script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          if (window.self !== window.top) root.className += ' framed';
        } catch (e) {
          root.className += ' framed';
        }
        var data = JSON.parse(document.getElementById('hoi-data').textContent);
        var input = document.getElementById('hoi-q');
        var list = document.getElementById('hoi-results');
        var status = document.getElementById('hoi-status');
        var tone = function (b) { return b === 'Severe' || b === 'Elevated' ? 'red' : b === 'Moderate' ? 'ink' : 'blue'; };
        var pct = function (p) {
          if (p === null) return 'not published';
          var s = (Math.round(Math.abs(p) * 10) / 10).toString();
          return (p > 0 ? '+' : p < 0 ? '\u2212' : '') + s + '%';
        };
        var norm = function (s) { return s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim(); };
        var el = function (tag, cls, text) {
          var n = document.createElement(tag);
          if (cls) n.className = cls;
          if (text !== undefined) n.textContent = text;
          return n;
        };
        var render = function (rows) {
          list.textContent = '';
          rows.forEach(function (e) {
            var li = el('li');
            li.appendChild(el('span', 'hoi-rank', '#' + e.r));
            var a = el('a', '', e.t);
            a.href = e.u;
            a.target = '_blank';
            a.rel = 'noopener';
            li.appendChild(a);
            li.appendChild(el('span', 'hoi-score ' + tone(e.b), String(e.o)));
            li.appendChild(el('span', 'hoi-meta', 'Doom Score band ' + e.b + ' \u00b7 BLS category ' + (e.c || 'not rated') + ' \u00b7 BLS 2025\u201335 ' + pct(e.p)));
            list.appendChild(li);
          });
        };
        var search = function () {
          var q = norm(input.value);
          if (!q) {
            render(data.slice(0, 5));
            status.textContent = 'Top 5 of ' + data.length + ' on the board. Type to search.';
            return;
          }
          var words = q.split(' ');
          var hits = data.filter(function (e) {
            var t = norm(e.t);
            return words.every(function (w) { return t.indexOf(w.replace(/s$/, '')) !== -1; });
          });
          render(hits.slice(0, 6));
          status.textContent = hits.length === 0
            ? 'No match on the ' + data.length + '-occupation board. It lists the highest scores only; try a broader word.'
            : hits.length + (hits.length === 1 ? ' match' : ' matches') + (hits.length > 6 ? ', showing the top 6' : '') + '.';
        };
        input.addEventListener('input', search);
        var copy = document.getElementById('hoi-copy');
        var copied = document.getElementById('hoi-copied');
        var code = document.getElementById('hoi-snippet');
        copy.addEventListener('click', function () {
          var text = code.textContent;
          var done = function () { copied.textContent = 'Copied.'; };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, function () { copied.textContent = 'Select the snippet and copy it.'; });
          } else {
            var range = document.createRange();
            range.selectNodeContents(code);
            var sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            copied.textContent = 'Snippet selected. Press Ctrl+C or Cmd+C.';
          }
        });
      })();
    </script>
  </body>
</html>
