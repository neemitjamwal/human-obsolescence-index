---
import BaseLayout from '../layouts/BaseLayout.astro';
import { META, leaderboard, sourceById } from '../lib/data';
import { quotableStats } from '../lib/press';
import { sourceShort } from '../data/references';

const stats = quotableStats();
const board = leaderboard();
const year = META.dataAsOf.slice(0, 4);
const citation = `Human Obsolescence Index, ${META.edition} edition (data as of ${META.dataAsOf}). https://humanobsolescenceindex.com/`;
const sourceHref = (id: string) => sourceById(id).url;
const PACK = [
  { href: '/stat-pack/hoi-top50.csv', name: 'hoi-top50.csv', what: `The top 50 leaderboard occupations: rank, SOC code, OBS, Exposure, Trajectory, both exposure percentiles, BLS projected change, BLS category, 2025 employment, median wage and page URL.` },
  { href: '/stat-pack/sources.json', name: 'sources.json', what: 'The source manifest: URL, retrieval date, SHA-256 hash, byte size, license and citation for every input file.' },
  { href: '/stat-pack/README.txt', name: 'README.txt', what: 'What the files are, the one-line caveat and the attribution text.' },
];
---

<BaseLayout title="Press" description={`Press kit for the ${META.edition} Human Obsolescence Index: how to cite it, quotable stats with sources, and a downloadable stat pack.`}>
  <article class="mx-auto max-w-3xl px-4 py-12 md:px-6">
    <p class="eyebrow">Press kit · {META.edition}</p>
    <h1 class="page-h mt-4"><span class="hl">Press</span></h1>
    <p class="prose-block mt-4">
      The Human Obsolescence Index ranks {board.length} U.S. occupations by a composite Doom Score (OBS): how exposed their work is
      to AI, and how weak BLS's projected employment change for them is from 2025 to 2035, both relative to every other
      occupation BLS projects. A high score does not mean a job is shrinking or that hiring is falling. It is built only from public data, updated
      quarterly, and every figure traces to a named source file with a SHA-256 hash.
    </p>

    <section class="mt-14" aria-labelledby="cite-title" id="how-to-cite">
      <h2 id="cite-title" class="section-h">How to cite</h2>
      <p class="prose-block mt-2">Suggested citation:</p>
      <p class="box mt-2 p-4 text-sm break-words" data-citation>{citation}</p>
      <ul class="prose-block mt-4 list-disc space-y-2 pl-5">
        <li>Call the Doom Score (OBS) "the Human Obsolescence Index's composite score". It is ours, not a government number.</li>
        <li>Attribute the "Very high / High / Moderate / Low" category to the U.S. Bureau of Labor Statistics. It is BLS's label.</li>
        <li>Please do not write that a job "will be replaced" because of a high score. Exposure measures what AI can do to an occupation's tasks, not whether the job disappears.</li>
        <li>Link the occupation page you quote. Each one carries its full receipts.</li>
      </ul>
    </section>

    <section class="mt-14" aria-labelledby="stats-title" id="stats">
      <h2 id="stats-title" class="section-h">Quotable stats</h2>
      <ul class="mt-4 space-y-3" data-quotable-stats>
        {
          stats.map((s) => (
            <li class="box p-4" data-stat={s.id}>
              <p class="prose-block">{s.text}</p>
              <p class="kicker mt-2">
                Source:{' '}
                {s.sourceIds.map((id, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a class="cite-link" href={sourceHref(id)} data-stat-source={id}>{sourceShort(id)}</a>
                  </>
                ))}
                {s.href && <> · <a class="cite-link" href={s.href}>see the page</a></>}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14" aria-labelledby="pack-title" id="stat-pack">
      <h2 id="pack-title" class="section-h">Download the stat pack</h2>
      <p class="prose-block mt-2">
        Free to reuse with attribution. Our composite scores are CC BY 4.0; upstream licenses apply to the inputs (see
        {' '}<a class="underline" href="/about/#licensing">licensing</a>).
      </p>
      <ul class="mt-4 space-y-3" data-stat-pack>
        {
          PACK.map((p) => (
            <li class="box flex flex-col gap-2 p-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <p class="font-display text-2xl uppercase">{p.name}</p>
                <p class="mt-1 text-sm">{p.what}</p>
              </div>
              <a class="filter-chip shrink-0 self-start no-underline" href={p.href} download={p.name}>Download {p.name}</a>
            </li>
          ))
        }
      </ul>
      <p class="kicker mt-4">© {year} Human Obsolescence Index · Methodology: <a class="underline" href="/methodology/">/methodology/</a></p>
    </section>
  </article>
</BaseLayout>
